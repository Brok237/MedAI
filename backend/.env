# backend/.env.example
# Copy this to .env and fill in your values.

# ── Django core ───────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-key-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

DATABASE_URL=sqlite:///db.sqlite3

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=db+sqlite:///celery.sqlite3
CELERY_RESULT_BACKEND=db+sqlite:///celery.sqlite3
FASTAPI_ML_URL=http://localhost:8001
# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=889735295377-602jv72v01v0aq7fdmtf2furngdsvc2t.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Email (Gmail SMTP example) ────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@medai.app

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=https://your-flutter-web-domain.com
